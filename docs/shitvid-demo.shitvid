{
  "version": "shitvid-hackathon/1",
  "project_dir": ".",
  "narration": {
    "provider": "piper",
    "model": "voices/en_US-lessac-medium.onnx",
    "language": "en-US",
    "pre_generate": true
  },
  "automation": {
    "browser": { "provider": "none" }
  },
  "capture": {
    "provider": "none"
  },
  "render_profiles": {
    "hackathon": {
      "output_format": "mp4",
      "max_duration": 180,
      "captions": true,
      "meme_overlays": false,
      "random_cuts": false,
      "fake_terminal": false,
      "reaction_images": false,
      "render": {
        "source_video": "demo/input.mp4",
        "script": "hackathon_narration.txt",
        "preset": "hackathon-clean",
        "assets_dir": "../../shitvid/assets",
        "presets_dir": "../../shitvid/presets",
        "output": "isyco_calle_demo.mp4"
      }
    }
  },
  "routes": {
    "calle_bridge": {
      "render_profile": "hackathon",
      "sequence": [
        { "say": "ISyCo CALL Bridge. One command, two paths." },
        {
          "run": {
            "argv": ["{python}", "-m", "isyco_calle.demo"],
            "cwd": ".",
            "timeout": 30,
            "expect_exit": [0]
          }
        },
        { "capture_marker": "denied_path_shown" },
        { "say": "No grant, no call. The mock provider is not the phone company." },
        { "capture_marker": "authorized_path_shown" },
        { "say": "With authority, CALL-E places the real call. Evidence preserved." }
      ],
      "render": { "output": "isyco_calle_demo.mp4" }
    }
  }
}