# Copy to .env (or export in your shell) and fill in real values. Never commit .env.

# REQUIRED - CALL-E API key. Get it from the CALL-E dashboard:
# https://dashboard.heycall-e.com/account/api-keys
CALLE_API_KEY=calle_live_key

# OPTIONAL - override base URL (defaults to https://api.heycall-e.com)
# CALLE_BASE_URL=https://api.heycall-e.com

# OPTIONAL - SDK timeout in seconds (default 120)
# CALLE_TIMEOUT=120

# OPTIONAL - default caller identity for CLI authority checks
# ISYCO_CALL_DEFAULT_CALLER=cli